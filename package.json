{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/dev-vars.mjs",
    "dev": "CLOUDFLARE_ENV=development vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs}\"",
    "release:check": "node scripts/release-check.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:access": "node scripts/access-registry.mjs",
    "security:deps": "npm audit --audit-level=high",
    "security:secrets": "node scripts/secret-scan.mjs",
    "test:client": "vitest run --config vitest.client.config.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "start": "vite build && vite preview --port 4173 --open",
    "postinstall": "node scripts/patch-vaul.mjs",
    "e2e": "playwright test",
    "e2e:prod": "E2E_PROD=1 playwright test",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "db:seed:local": "node scripts/seed-dev.mjs",
    "e2e:browsers": "playwright test -c playwright.browsers.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fuse.js": "^7.5.0",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.5.0",
    "next-themes": "^0.4.6",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0",
    "yaml": "2.9.1"
  }
}
