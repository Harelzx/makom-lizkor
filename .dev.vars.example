# Template for .dev.vars (untracked). `npm run dev` and the e2e servers copy it there when .dev.vars is missing;
# the Worker tests read this template directly, so they never depend on a local edit. Wrangler never deploys either file.
# Synthetic values, not secrets. They switch on the stand-in Access sign-in (/__dev/login) and the X-Test-Now clock.
ENVIRONMENT=development
MODERATORS=dev@example.test
OPS_SERVICE_TOKENS=dev-ops.access
MODERATOR_SERVICE_TOKENS=dev-staging-moderator.access
PROBE_SERVICE_TOKENS=dev-purge-probe.access
DEV_ACCESS_SECRET=development-only-not-a-secret
# Cloudflare's published Turnstile test secret (always passes); its test tokens come back for example.com.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=example.com
# Derives each submission's tracking token from its key (HMAC); a real secret in production, set with wrangler secret.
TRACKING_SECRET=development-tracking-secret-not-a-secret
# Keys the daily hash of an anemone's device id (HMAC); a real secret in production, set with wrangler secret.
TRIBUTE_SECRET=development-tribute-secret-not-a-secret
# A synthetic key pair's public half: the dev server's exports are encrypted to it. Its private half is in no file.
