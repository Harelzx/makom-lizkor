{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makom-lizkor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The SPA is served as static assets; only these paths run the Worker.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/__dev/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "makom-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
  ],
  // What a deploy ships: production, with no moderators until the deploy names them and no development secret.
  // Locally, .dev.vars (read by the dev server and the tests, never deployed) turns development on.
  "vars": {
    "ENVIRONMENT": "production",
    "EPOCH": "0",
    "MODERATORS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  // Our own JSON log lines only; no automatic per-request records (they carry URLs and headers).
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
}
