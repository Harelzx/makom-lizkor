{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makom-lizkor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The SPA is served as static assets; only these paths run the Worker.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/__dev/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "makom-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
  ],
  // What a deploy ships: production, with no moderators until the deploy names them and no development secret.
  // Locally, .dev.vars (read by the dev server and the tests, never deployed) turns development on.
  "vars": {
    "ENVIRONMENT": "production",
    "EPOCH": "0",
    "MODERATORS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The hostnames Turnstile may vouch for; set per deploy. The secret is a secret, never a var.
    "TURNSTILE_HOSTNAMES": "",
    // Past this many submissions waiting for review, the form stops politely (spec 12, load shedding).
    "QUEUE_LIMIT": "200",
  },
  // A coarse outer cap per visitor's address, counted by Cloudflare at the edge: nothing about the address is stored.
  "ratelimits": [{ "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Our own JSON log lines only; no automatic per-request records (they carry URLs and headers).
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
}
