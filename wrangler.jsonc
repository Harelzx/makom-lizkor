{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makom-lizkor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // No side door around Access: the site is reached only at its own domain (spec 11; release:check, release-platform).
  "workers_dev": false,
  "preview_urls": false,
  // The SPA is served as static assets; only these paths run the Worker.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // A place's share page (/place/<id>) is the site's page with the place's preview tags, written by the Worker.
    "run_worker_first": ["/api/*", "/__dev/*", "/media/*", "/place/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makom-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // What a deploy ships: production, with no moderators until the deploy names them and no development secret.
  // Locally, .dev.vars (read by the dev server and the tests, never deployed) turns development on.
  "vars": {
    "ENVIRONMENT": "production",
    "EPOCH": "0",
    "MODERATORS": "",
    // The diagnostic agent's Access service token client ids (spec 12.1), comma-separated; empty: no one.
    "OPS_SERVICE_TOKENS": "",
    // A machine moderator's service token client ids: staging only (H1). Production refuses any, and release:check
    // refuses a release that sets one.
    "MODERATOR_SERVICE_TOKENS": "",
    // The purge probe's own service token (L-PURGE): set for a deployment that runs the probe, empty refuses it.
    "PROBE_SERVICE_TOKENS": "",
    // A shorter retention day, staging only (worker/lib/durations.ts); empty everywhere a deploy ships, and refused
    // outside staging by the Worker and by release:check.
    "RETENTION_DAY_SECONDS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The hostnames Turnstile may vouch for; set per deploy. The secret is a secret, never a var.
    "TURNSTILE_HOSTNAMES": "",
    // Past this many submissions waiting for review, the form stops politely (spec 12, load shedding).
    "QUEUE_LIMIT": "200",
    // The site's own address, for absolute links in share pages (og:url, og:image); set with the domain, a launch item.
    "PUBLIC_ORIGIN": "",
    // The public keys each export is encrypted to (a JSON array of RSA-OAEP JWKs): the owner's, whose private half
    // stays offline, and the drill's, whose private half is a secret. Empty: no export is written, and the check alerts.
    "EXPORT_PUBLIC_KEYS": "",
  },
  // Photos: quarantine/ until a moderator approves, public/ after. No public bucket; the Worker serves public/ only.
  // The ledger: every decision, ids and codes only, written before and after it (spec 8.2). Bucket lock is an account
  // setting, applied with the retention work before launch.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "makom-media", "jurisdiction": "eu" },
    { "binding": "LEDGER", "bucket_name": "makom-ledger", "jurisdiction": "eu" },
    // The nightly export, encrypted, and the photos it lists, stored by their sha256 (spec 8.1). Kept 35 days; the
    // 34-day bucket lock is an account setting, applied before launch.
    { "binding": "EXPORTS", "bucket_name": "makom-exports", "jurisdiction": "eu" },
  ],
  // A coarse outer cap per visitor's address, counted by Cloudflare at the edge: nothing about the address is stored.
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Anemones: generous, since a visitor may leave one at many places; the database already counts one a day each.
    { "name": "TRIBUTE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Removal requests: a few a minute is plenty for a person; the database counts the day's (REPORT_GUARDS).
    { "name": "REPORT_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // CSP reports: a page breaking the policy sends one per blocked load; past twenty a minute it is the same news.
    { "name": "CSP_LIMIT", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
  ],
  // The scheduled jobs (worker/jobs.ts): unfinished decisions, the 24-hour backstop, reminders to moderators, and the
  // removal requests' abuse codes, cleared after RETENTION.reportAbuseCodeHours.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Our own JSON log lines only; no automatic per-request records (they carry URLs and headers).
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  // The serving version's id and tag (the deploy tags it with its commit or release): every answer names the tag, so a
  // check right after a deploy can tell the new version's answers from the previous one's (a61).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    // Staging (spec 14.1): synthetic data only, in the staging account, on its workers.dev address behind Cloudflare
    // Access. Built with CLOUDFLARE_ENV=staging and deployed only by .github/workflows/staging.yml, which fills the
    // empty vars from the repository's variables and the secrets from its secrets. Never development: ENVIRONMENT is
    // "staging" and there is no DEV_ACCESS_SECRET, so /__dev and X-Test-Now stay closed (scripts/staging-check.mjs).
    // Bindings aren't inherited from the top level, so each is named here, apart from production's.
    "staging": {
      "name": "makom-lizkor-staging",
      "workers_dev": true,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "makom-staging",
          // The staging database, created 2026-10-07 in jurisdiction eu (an id is not a secret).
          "database_id": "6cebc14f-18b1-41fd-9d21-fd885e71ce25",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "EPOCH": "0",
        "MODERATORS": "",
        "OPS_SERVICE_TOKENS": "",
        // Staging's synthetic machine moderator (H1): filled from STAGING_MODERATOR_SERVICE_TOKENS at deploy time.
        "MODERATOR_SERVICE_TOKENS": "",
        "PROBE_SERVICE_TOKENS": "",
        // Set from vars.STAGING_RETENTION_DAY_SECONDS at deploy time; unset, staging keeps real days.
        "RETENTION_DAY_SECONDS": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "TURNSTILE_HOSTNAMES": "",
        "QUEUE_LIMIT": "200",
        "PUBLIC_ORIGIN": "",
        "EXPORT_PUBLIC_KEYS": "",
      },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "makom-staging-media", "jurisdiction": "eu" },
        { "binding": "LEDGER", "bucket_name": "makom-staging-ledger", "jurisdiction": "eu" },
        { "binding": "EXPORTS", "bucket_name": "makom-staging-exports", "jurisdiction": "eu" },
      ],
      "ratelimits": [
        { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "TRIBUTE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "REPORT_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
        { "name": "CSP_LIMIT", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
      ],
    },
  },
}
