{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 140,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "src/index.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": "src/components/ui/**",
      "options": { "printWidth": 80, "trailingComma": "es5" }
    }
  ]
}
